# Copy this file to .env for local testing. On Vercel, add the same names under
# Project Settings > Environment Variables. Never commit the real .env file.

# MIS logins, comma separated, as name:password. No commas inside passwords.
ADMIN_USERS=mis.head:change-this-password,mis.exec:another-strong-password

# Long random string that signs login cookies. Make one with: openssl rand -hex 32
ADMIN_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Where saved data lives. Added automatically when you connect Upstash Redis
# from the Vercel Marketplace (either pair of names works). Leave blank locally:
# a file in .data/ is used instead.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Doer dashboard (033 Material Tracking FMS). Uses the Google Sheets API, no Apps Script.
# Service account from Google Cloud (Sheets API on). Share the sheet with this email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=name@project.iam.gserviceaccount.com
# Paste the private_key from the JSON key, keeping the \n characters, inside quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The long id in the sheet link: /spreadsheets/d/<THIS PART>/edit
FMS033_SHEET_ID=15jy-Er_zkpEByal3SXq0YEUI3aeCi1x_QCxZ7lrr1SY
FMS033_GID=0
